rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function perfilPath() {
      return /databases/$(database)/documents/perfiles/$(request.auth.uid);
    }

    function hasPerfil() {
      return signedIn() && exists(perfilPath());
    }

    function perfilData() {
      return get(perfilPath()).data;
    }

    function isAdmin() {
      return hasPerfil() && perfilData().role == 'admin';
    }

    function isAdminEmpresa() {
      return hasPerfil() && perfilData().role == 'admin_empresa';
    }

    function isEmpleado() {
      return hasPerfil() && perfilData().role == 'empleado';
    }

    function isRolCliente() {
      return hasPerfil() && perfilData().role == 'cliente';
    }

    function esClienteLegacy() {
      return signedIn() &&
        exists(/databases/$(database)/documents/clientes/$(request.auth.uid)) &&
        !hasPerfil();
    }

    function puedeComprarComoCliente() {
      return signedIn() && (isRolCliente() || esClienteLegacy());
    }

    function ofertaEsDeMiEmpresa() {
      return isAdminEmpresa() && (
        (perfilData().empresaId != null && resource.data.empresaId == perfilData().empresaId) ||
        (perfilData().nombreEmpresa != null && resource.data.nombreEmpresa == perfilData().nombreEmpresa)
      );
    }

    function nuevaOfertaEsDeMiEmpresa() {
      return isAdminEmpresa() && (
        (perfilData().empresaId != null && request.resource.data.empresaId == perfilData().empresaId) ||
        (perfilData().nombreEmpresa != null && request.resource.data.nombreEmpresa == perfilData().nombreEmpresa)
      );
    }

    /** Transiciones de estado que la empresa puede hacer sola (sin volver a aprobar). */
    function adminEmpresaTransicionOfertaPermitida() {
      return request.resource.data.estado == resource.data.estado ||
        (resource.data.estado == 'rechazada' &&
          (request.resource.data.estado == 'pendiente' || request.resource.data.estado == 'descartada')) ||
        (resource.data.estado == 'pendiente' && request.resource.data.estado == 'descartada');
    }

    function adminEmpresaPuedeActualizarOferta() {
      return signedIn() && isAdminEmpresa() && ofertaEsDeMiEmpresa() &&
        !(request.resource.data.estado == 'aprobada' && resource.data.estado != 'aprobada') &&
        adminEmpresaTransicionOfertaPermitida();
    }

    /**
     * Doc empresas del perfil. Solo usar cuando perfilData().empresaId != null
     * y exists(/empresas/{ese id}) (short-circuit en la condición).
     */
    function empresaDelPerfil() {
      return get(/databases/$(database)/documents/empresas/$(perfilData().empresaId)).data;
    }

    /**
     * Cupón emitido con prefijo codigoEmpresa de la empresa del empleado (EVS001 + 7 dígitos).
     * Cubre cupones con nombreEmpresa distinto al campo nombre en empresas.
     */
    function empleadoPuedeVerCuponPorPrefijoCodigo(cupon) {
      return perfilData().empresaId != null &&
        exists(/databases/$(database)/documents/empresas/$(perfilData().empresaId)) &&
        cupon.codigo is string &&
        empresaDelPerfil().codigoEmpresa is string &&
        empresaDelPerfil().codigoEmpresa.size() == 6 &&
        cupon.codigo.matches(
          '^' + empresaDelPerfil().codigoEmpresa + '[0-9]{7}$'
        );
    }

    /**
     * Misma empresa: ids iguales; o nombre en perfil = nombre en cupón (sin distinguir mayúsculas);
     * o nombre del doc empresas/{perfil.empresaId} = nombreEmpresa del cupón (idem);
     * o prefijo del código = codigoEmpresa de esa empresa.
     */
    function empleadoPuedeVerCupon(cupon) {
      return isEmpleado() && (
        (perfilData().empresaId != null && cupon.empresaId == perfilData().empresaId) ||
        (
          perfilData().nombreEmpresa is string &&
          cupon.nombreEmpresa is string &&
          perfilData().nombreEmpresa.lower() == cupon.nombreEmpresa.lower()
        ) ||
        (
          perfilData().empresaId != null &&
          cupon.nombreEmpresa is string &&
          exists(/databases/$(database)/documents/empresas/$(perfilData().empresaId)) &&
          empresaDelPerfil().nombre is string &&
          empresaDelPerfil().nombre.lower() == cupon.nombreEmpresa.lower()
        ) ||
        empleadoPuedeVerCuponPorPrefijoCodigo(cupon)
      );
    }

    function empleadoMismaEmpresaQuePerfil(data) {
      return (perfilData().empresaId != null && data.empresaId == perfilData().empresaId) ||
        (perfilData().nombreEmpresa != null && data.nombreEmpresa == perfilData().nombreEmpresa);
    }

    /** Cupón aún válido por fecha límite de canje (si existe). */
    function cuponDentroDeFechaLimite() {
      return resource.data.fechaLimiteCupon == null ||
        request.time <= resource.data.fechaLimiteCupon;
    }

    /**
     * Canje sin Cloud Function (plan Spark): solo empleado de la misma empresa,
     * DUI presentado igual al del titular (mismo string que en el documento),
     * y solo pueden cambiar los cuatro campos del canje (update parcial).
     */
    function empleadoPuedeRegistrarCanje() {
      return isEmpleado() &&
        empleadoPuedeVerCupon(resource.data) &&
        cuponDentroDeFechaLimite() &&
        resource.data.estado == 'disponible' &&
        request.resource.data.estado == 'canjeado' &&
        request.resource.data.canjeadoPorUid == request.auth.uid &&
        request.resource.data.duiPresenteEnCanje == resource.data.clienteDui &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['estado', 'fechaCanje', 'canjeadoPorUid', 'duiPresenteEnCanje']);
    }

    function invitacionEmpleadoValida(userId) {
      return isAdminEmpresa() &&
        request.auth.uid != userId &&
        request.resource.data.role == 'empleado' &&
        empleadoMismaEmpresaQuePerfil(request.resource.data);
    }

    match /rubros/{rubroId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /perfiles/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        (isAdminEmpresa() && resource.data.role == 'empleado' &&
          empleadoMismaEmpresaQuePerfil(resource.data))
      );
      allow create: if signedIn() && (
        (request.auth.uid == userId && request.resource.data.role == 'cliente') ||
        isAdmin() ||
        invitacionEmpleadoValida(userId)
      );
      allow update: if isAdmin() || (
        isAdminEmpresa() &&
        request.auth.uid != userId &&
        resource.data.role == 'empleado' &&
        request.resource.data.role == 'empleado' &&
        empleadoMismaEmpresaQuePerfil(resource.data) &&
        empleadoMismaEmpresaQuePerfil(request.resource.data)
      );
      allow delete: if isAdmin() || (
        isAdminEmpresa() &&
        request.auth.uid != userId &&
        resource.data.role == 'empleado' &&
        empleadoMismaEmpresaQuePerfil(resource.data)
      );
    }

    match /clientes/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /empresas/{empresaId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /ofertas/{ofertaId} {
      allow read: if resource.data.estado == 'aprobada' ||
        (signedIn() && isAdmin()) ||
        (signedIn() && ofertaEsDeMiEmpresa());

      allow create: if signedIn() && isAdminEmpresa() &&
        nuevaOfertaEsDeMiEmpresa() &&
        request.resource.data.estado == 'pendiente';

      allow update: if isAdmin() ||
        adminEmpresaPuedeActualizarOferta() ||
        (puedeComprarComoCliente() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cuponesVendidos']));

      allow delete: if isAdmin() || (signedIn() && isAdminEmpresa() && ofertaEsDeMiEmpresa());
    }

    match /cupones/{cuponId} {
      allow read: if signedIn() && (
        resource.data.clienteUid == request.auth.uid ||
        isAdmin() ||
        empleadoPuedeVerCupon(resource.data)
      );

      allow create: if puedeComprarComoCliente() &&
        request.resource.data.clienteUid == request.auth.uid &&
        request.resource.data.estado == 'disponible' &&
        request.resource.data.clienteDui is string &&
        request.resource.data.clienteDui.size() >= 8;

      allow update: if isAdmin() || empleadoPuedeRegistrarCanje();

      allow delete: if isAdmin();
    }

    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}
